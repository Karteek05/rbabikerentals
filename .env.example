# App Settings
APP_ENV=
APP_BASE_URL=
# Payment/partner emails use this when set (so links work on your phone during local dev)
APP_PUBLIC_BASE_URL=

# Better Auth Settings
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google Auth Settings (Create these in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Settings (Get these from Supabase Dashboard -> Project Settings)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection String (URI)
DATABASE_URL=
# Razorpay Settings (Optional for now, but needed for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Setu DigiLocker (KYC — Aadhaar + driving licence via DigiLocker product on Bridge)
# Bridge: KYC merchants → RBAbikerentals → set up DigiLocker → copy Product Instance ID
# Sandbox base URL below; production use https://dg.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_DIGILOCKER_BASE_URL=
# Where Setu sends the user after DigiLocker consent (must match Bridge config)
# Local: http://localhost:3000/kyc  |  Production: https://rbabikerentals.com/kyc
SETU_REDIRECT_URL=
# Random secret you choose; must match Setu webhook/callback if configured
SETU_WEBHOOK_SECRET=

# Supabase vehicle document storage (insurance/RC/invoice PDFs)
SUPABASE_VEHICLE_DOC_BUCKET=

# Dev Settings
ALLOW_DEV_HEADERS=

# Email / Notifications Settings
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=