# App settings
APP_ENV=
APP_BASE_URL=
APP_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=


# Better Auth Settings
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google Auth Settings (Create these in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Settings (Project Settings -> API / Database)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep the vehicle-documents bucket private; vehicle-images is public.
SUPABASE_VEHICLE_DOC_BUCKET=vehicle-documents
SUPABASE_VEHICLE_IMAGE_BUCKET=vehicle-images

# PostgreSQL connection used by Better Auth and database scripts.
SUPABASE_DB_URL=
DATABASE_URL=
# Razorpay is required for online checkout; without it checkout is unavailable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Aadhaar/DigiLocker verification is paused pending required permissions. No Setu variables are required.

# Google Maps
GOOGLE_MAPS_API_KEY=

# CIBIL provider. Keep mock until production credentials and policy are approved.
CIBIL_PROVIDER_MODE=mock
CIBIL_API_URL=
CIBIL_API_KEY=

# Internal scheduled jobs and tracking endpoint authentication
JOB_SECRET=


# Dev Settings
ALLOW_DEV_HEADERS=

# Email / Notifications Settings. ADMIN_EMAIL is also the public contact address.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
