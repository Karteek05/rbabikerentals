{
  "name": "rbabikerentals-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/ensure-next-types.mjs && tsc --noEmit",
    "typecheck": "node scripts/ensure-next-types.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "bootstrap:admin": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "check-db": "tsx --env-file=.env scripts/check-db.ts",
    "import:vehicle-docs": "tsx --env-file=.env scripts/import-vehicle-docs.ts",
    "import:vehicle-docs:match": "tsx --env-file=.env scripts/import-vehicle-docs.ts --match-only",
    "link:fleet-catalog": "tsx --env-file=.env scripts/link-fleet-catalog.ts",
    "job:documents": "tsx --env-file=.env scripts/jobs/document-expiry.ts",
    "job:incidents": "tsx --env-file=.env scripts/jobs/incident-escalation.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@supabase/supabase-js": "2.57.4",
    "better-auth": "^1.6.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.4",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "8.16.3",
    "razorpay": "^2.9.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
